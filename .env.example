# ─────────────────────────────────────────────────────────────────────────────
# FastPark — Variables d'environnement
# Copier ce fichier en .env et remplir les valeurs
# Ne JAMAIS committer .env sur Git (.gitignore le protège déjà)
# ─────────────────────────────────────────────────────────────────────────────

# ── Sécurité Flask ────────────────────────────────────────────────────────────
# Générer avec : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_MOI_AVANT_PRODUCTION

# ── Compte admin ─────────────────────────────────────────────────────────────
# Utilisé uniquement à la 1ère création du compte admin
ADMIN_PASSWORD=CHANGE_MOI_AUSSI

# ── MQTT ─────────────────────────────────────────────────────────────────────
MQTT_BROKER=172.16.2.64
MQTT_PORT=1883

# ── CORS ─────────────────────────────────────────────────────────────────────
# En développement :
ALLOWED_ORIGINS=http://localhost:5000
# En production (exemple) :
# ALLOWED_ORIGINS=https://fastpark.ton-domaine.ma

# ── Intelligence Artificielle — Groq (100% GRATUIT) ──────────────────────────
# 1. Va sur https://console.groq.com
# 2. Crée un compte (Google ou GitHub, sans carte bancaire)
# 3. API Keys → "Create API Key"
# 4. Colle la clé ci-dessous (commence par gsk_...)
# Sans clé → le chatbot répond en mode local (réponses simples mais fonctionnelles)
GROQ_API_KEY=gsk_VOTRE_CLE_ICI
